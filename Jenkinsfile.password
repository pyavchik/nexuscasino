pipeline {
    agent any
    
    environment {
        // Server configuration
        SERVER_HOST = 'pyavchik.space'
        SERVER_USER = 'root'
        // Password stored in Jenkins credentials as 'server-ssh-password'
        DEPLOY_PATH = '/opt/nexus-casino'
        DOCKER_COMPOSE_FILE = 'docker-compose.prod.yml'
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.BRANCH_NAME = env.BRANCH_NAME ?: env.GIT_BRANCH?.replaceAll('origin/', '') ?: 'unknown'
                    echo "Building branch: ${env.BRANCH_NAME}"
                    
                    // Check if this is a feature branch
                    def isFeatureBranch = env.BRANCH_NAME =~ /^(feature|fix|hotfix|release)\/.+/
                    def isMainBranch = env.BRANCH_NAME == 'main' || env.BRANCH_NAME == 'master'
                    
                    env.IS_FEATURE_BRANCH = isFeatureBranch.toString()
                    env.IS_MAIN_BRANCH = isMainBranch.toString()
                    env.SHOULD_DEPLOY = isFeatureBranch.toString()
                    
                    if (isMainBranch) {
                        echo "⚠️  WARNING: Building from ${env.BRANCH_NAME} branch"
                        echo "⚠️  Deployment will be SKIPPED - only feature branches are deployed"
                        echo "⚠️  To deploy, use a feature branch (feature/*, fix/*, hotfix/*, release/*)"
                    } else if (isFeatureBranch) {
                        echo "✅ Feature branch detected - deployment will proceed"
                    } else {
                        echo "⚠️  Branch '${env.BRANCH_NAME}' does not match feature branch pattern"
                        echo "⚠️  Deployment will be SKIPPED"
                        echo "⚠️  Use branches matching: feature/*, fix/*, hotfix/*, release/*"
                    }
                }
            }
        }
        
        stage('Build Docker Images') {
            steps {
                script {
                    echo 'Building Docker images...'
                    sh '''
                        # Build backend
                        cd backend
                        docker build -t nexus-casino-backend:latest .
                        cd ..
                        
                        # Build frontend with production Dockerfile
                        cd frontend
                        docker build -f Dockerfile.prod \
                            --build-arg VITE_API_BASE_URL=https://${SERVER_HOST}/api \
                            --build-arg VITE_WS_URL=wss://${SERVER_HOST}/ws \
                            -t nexus-casino-frontend:latest .
                        cd ..
                    '''
                }
            }
        }
        
        stage('Save Docker Images') {
            steps {
                script {
                    echo 'Saving Docker images to tar files...'
                    sh '''
                        mkdir -p docker-images
                        docker save nexus-casino-backend:latest -o docker-images/backend.tar
                        docker save nexus-casino-frontend:latest -o docker-images/frontend.tar
                        docker save postgres:15-alpine -o docker-images/postgres.tar || docker pull postgres:15-alpine && docker save postgres:15-alpine -o docker-images/postgres.tar
                    '''
                }
            }
        }
        
        stage('Transfer Files to Server') {
            when {
                expression { env.SHOULD_DEPLOY == 'true' }
            }
            steps {
                script {
                    echo 'Transferring files to deployment server...'
                    withCredentials([usernamePassword(
                        credentialsId: 'server-ssh-password',
                        usernameVariable: 'SSH_USER',
                        passwordVariable: 'SSH_PASS'
                    )]) {
                        sh '''
                            # Install sshpass if not available (check first)
                            which sshpass || echo "sshpass not found, will use ssh with password prompt"
                            
                            # Create deployment directory on server
                            sshpass -p "$SSH_PASS" ssh -o StrictHostKeyChecking=no ${SSH_USER}@${SERVER_HOST} \
                                "mkdir -p ${DEPLOY_PATH} && mkdir -p ${DEPLOY_PATH}/docker-images"
                            
                            # Transfer docker-compose file
                            sshpass -p "$SSH_PASS" scp -o StrictHostKeyChecking=no \
                                docker-compose.prod.yml \
                                ${SSH_USER}@${SERVER_HOST}:${DEPLOY_PATH}/
                            
                            # Transfer .env file if exists
                            if [ -f .env.production ]; then
                                sshpass -p "$SSH_PASS" scp -o StrictHostKeyChecking=no \
                                    .env.production \
                                    ${SSH_USER}@${SERVER_HOST}:${DEPLOY_PATH}/.env
                            fi
                            
                            # Transfer deployment script
                            sshpass -p "$SSH_PASS" scp -o StrictHostKeyChecking=no \
                                deploy.sh \
                                ${SSH_USER}@${SERVER_HOST}:${DEPLOY_PATH}/
                            
                            # Transfer nginx config for frontend
                            sshpass -p "$SSH_PASS" scp -o StrictHostKeyChecking=no \
                                frontend/nginx.conf \
                                ${SSH_USER}@${SERVER_HOST}:${DEPLOY_PATH}/
                            
                            # Transfer Docker images
                            echo "Transferring Docker images (this may take a while)..."
                            sshpass -p "$SSH_PASS" scp -o StrictHostKeyChecking=no \
                                docker-images/*.tar \
                                ${SSH_USER}@${SERVER_HOST}:${DEPLOY_PATH}/docker-images/
                        '''
                    }
                }
            }
        }
        
        stage('Deploy on Server') {
            when {
                expression { env.SHOULD_DEPLOY == 'true' }
            }
            steps {
                script {
                    echo 'Deploying application on server...'
                    withCredentials([usernamePassword(
                        credentialsId: 'server-ssh-password',
                        usernameVariable: 'SSH_USER',
                        passwordVariable: 'SSH_PASS'
                    )]) {
                        sh '''
                            sshpass -p "$SSH_PASS" ssh -o StrictHostKeyChecking=no ${SSH_USER}@${SERVER_HOST} \
                                "cd ${DEPLOY_PATH} && chmod +x deploy.sh && ./deploy.sh"
                        '''
                    }
                }
            }
        }
        
        stage('Health Check') {
            when {
                expression { env.SHOULD_DEPLOY == 'true' }
            }
            steps {
                script {
                    echo 'Performing health check...'
                    sleep(time: 30, unit: 'SECONDS')
                    sh '''
                        # Check if services are running
                        curl -f http://${SERVER_HOST}:8080/api/auth/me || echo "Backend health check failed"
                        curl -f http://${SERVER_HOST}:5173 || curl -f http://${SERVER_HOST}:80 || echo "Frontend health check failed"
                    '''
                }
            }
        }
    }
    
    post {
        success {
            script {
                if (env.SHOULD_DEPLOY == 'true') {
                    echo '✅ Deployment completed successfully!'
                    echo 'Application is available at:'
                    echo "  Frontend: https://${SERVER_HOST}"
                    echo "  Backend API: https://${SERVER_HOST}/api"
                } else {
                    echo '✅ Build completed successfully!'
                    echo "⚠️  Deployment was skipped (branch: ${env.BRANCH_NAME})"
                    echo "💡 To deploy, push to a feature branch (feature/*, fix/*, hotfix/*, release/*)"
                }
            }
        }
        failure {
            echo '❌ Build/Deployment failed! Check logs above for details.'
        }
        always {
            script {
                if (env.SHOULD_DEPLOY == 'true') {
                    // Cleanup only if deployment ran
                    sh '''
                        rm -rf docker-images
                    '''
                } else {
                    echo "ℹ️  Skipping cleanup (no deployment occurred)"
                }
            }
        }
    }
}

